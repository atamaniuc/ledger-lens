        {
          "name": "A run carries its own quality verdict",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "const dq = b.data_quality;",
                  "// US-05: every run gets a verdict, with no scheduler to deploy.",
                  "pm.test('the run returned a verdict', () => pm.expect(dq, JSON.stringify(b)).to.be.an('object'));",
                  "pm.test('all four checks ran, not a partial set', () => {",
                  "  pm.expect(dq.complete, JSON.stringify(dq && dq.results)).to.be.true;",
                  "  pm.expect(dq.results).to.have.lengthOf(4);",
                  "});",
                  "pm.test('the run is healthy overall', () => pm.expect(dq.overall).to.eql('pass'));",
                  "",
                  "// US-04, the headline number. Every cent the provider reported is either",
                  "// invoiced or accounted for in quarantine \u2014 not \"close enough\", zero.",
                  "const recon = dq.results.find(r => r.check_name === 'reconciliation');",
                  "pm.test('reconciliation drift is exactly 0', () => {",
                  "  pm.expect(Number(recon.delta), JSON.stringify(recon)).to.eql(0);",
                  "});",
                  "pm.test('no record has value that cannot be located', () => {",
                  "  pm.expect(Number(recon.details.unaccounted_rows)).to.eql(0);",
                  "});",
                  "pm.test('invoiced + quarantined equals the provider total', () => {",
                  "  pm.expect(Number(recon.details.invoiced_cents) + Number(recon.details.quarantined_cents))",
                  "    .to.eql(Number(recon.expected));",
                  "});",
                  "pm.collectionVariables.set('dqRunId', b.run_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              },
              {
                "key": "x-ingestion-secret",
                "value": "{{ingestionSecret}}"
              },
              {
                "key": "x-correlation-id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{baseUrl}}/api/ingestion/run",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"org_id\": \"{{orgA}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Reconciliation compares against accounted value rather than written value. Comparing against sum(invoices) alone reports an ~8.5% shortfall on a healthy pipeline, because quarantining corrupt records is correct behaviour, not loss. See ADR 0005."
          }
        },
