          "name": "A fully deduplicated re-run stays healthy",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('the re-run wrote nothing', () => pm.expect(b.rows_written).to.eql(0));",
                  "// The most normal thing this pipeline does must not read as an anomaly.",
                  "// Measuring the volume baseline on rows_written made it one: a run that",
                  "// deduplicates everything writes zero and scored -100% against its own",
                  "// history.",
                  "const vol = b.data_quality.results.find(r => r.check_name === 'volume');",
                  "pm.test('volume does not fail on a write-nothing re-run', () => {",
                  "  pm.expect(vol.status, JSON.stringify(vol)).to.not.eql('fail');",
                  "});",
                  "pm.test('reconciliation is still exactly 0', () => {",
                  "  const r = b.data_quality.results.find(x => x.check_name === 'reconciliation');",
                  "  pm.expect(Number(r.delta)).to.eql(0);",
                  "});"
                ]
              }
            }
