                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('all four checks ran', () => pm.expect(b.complete).to.be.true);",
                  "// Without a run there is no batch to size. Reporting the absent run as a",
                  "// zero-row batch failed volume on every ad-hoc invocation.",
                  "const vol = b.results.find(r => r.check_name === 'volume');",
                  "pm.test('volume abstains rather than failing', () => {",
