{
  "info": {
    "name": "LedgerLens \u2014 local",
    "description": "End-to-end checks against a locally running LedgerLens: the Next.js app (bun run dev) and the local Supabase stack (supabase start).\n\nSetup, and how to regenerate the environment file, are in docs/LOCAL_DEV.md. Run the whole collection with the Collection Runner \u2014 several requests call themselves in a loop via pm.execution.setNextRequest, which only works there, and later requests depend on variables earlier ones set.\n\nThis mirrors scripts/smoke.sh. The shell version is the one that runs unattended; this one is for watching what the system actually does, and it reaches one thing the shell version cannot \u2014 a real GoTrue sign-in, so RLS is exercised through a genuine JWT rather than an impersonated role.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Stage 1 \u2014 Mock Provider",
      "item": [
        {
          "name": "Summary \u2014 provider's own total",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('total_amount_cents is a positive integer', () => {",
                  "  pm.expect(b.total_amount_cents).to.be.a('number').and.to.be.above(0);",
                  "});",
                  "pm.test('invoice_count is a positive integer', () => {",
                  "  pm.expect(b.invoice_count).to.be.a('number').and.to.be.above(0);",
                  "});",
                  "// Kept for the pagination walk below, which reconciles against it.",
                  "pm.collectionVariables.set('providerInvoiceCount', b.invoice_count);",
                  "pm.collectionVariables.set('providerTotalCents', b.total_amount_cents);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/mock-provider/summary",
            "description": "The provider's independent summary. It always computes from the deduplicated dataset regardless of the duplicates flag, which is what makes it usable as a reconciliation source of truth rather than our own derived data compared against itself."
          }
        },
        {
          "name": "First page \u2014 upstream behaving itself",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('returns a non-empty page', () => pm.expect(b.data).to.be.an('array').that.is.not.empty);",
                  "pm.test('every record has an external_id', () => {",
                  "  b.data.forEach(r => pm.expect(r.external_id, JSON.stringify(r)).to.be.a('string'));",
                  "});",
                  "pm.test('next_cursor is a string or null', () => {",
                  "  pm.expect(b.next_cursor === null || typeof b.next_cursor === 'string').to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/mock-provider/invoices?duplicates=false&schemaDrift=false&nullFields=false&rateLimit=false&serverError=false&expiredToken=false&futureDates=false",
            "description": "All seven chaos flags off. Compare with the same URL minus the query string to see exactly what the flags inject."
          }
        },
        {
          "name": "Cursor walk \u2014 every page, then stop",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('walkCursor')) pm.collectionVariables.set('walkCursor', '0');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Walks the whole dataset by calling itself until next_cursor is null.",
                  "// Counters live in collection variables because each iteration is a fresh",
                  "// script execution.",
                  "const b = pm.response.json();",
                  "const pages   = Number(pm.collectionVariables.get('walkPages')   || 0) + 1;",
                  "const records = Number(pm.collectionVariables.get('walkRecords') || 0) + b.data.length;",
                  "pm.collectionVariables.set('walkPages', pages);",
                  "pm.collectionVariables.set('walkRecords', records);",
                  "",
                  "if (pm.response.code !== 200) {",
                  "  pm.test('walk: every page returns 200', () => pm.expect.fail('page ' + pages + ' returned ' + pm.response.code));",
                  "} else if (b.next_cursor !== null && pages < 50) {",
                  "  pm.collectionVariables.set('walkCursor', b.next_cursor);",
                  "  pm.execution.setNextRequest('Cursor walk \u2014 every page, then stop');",
                  "} else {",
                  "  pm.test('walk terminates rather than cycling', () => pm.expect(b.next_cursor).to.be.null);",
                  "  pm.test('walk fetched at least one page', () => pm.expect(pages).to.be.above(0));",
                  "  // The strong one: the deduplicated stream reconciles exactly against the",
                  "  // provider's independent count. Any silent drop or duplicate breaks this.",
                  "  pm.test('record count matches /summary exactly', () => {",
                  "    pm.expect(records).to.eql(Number(pm.collectionVariables.get('providerInvoiceCount')));",
                  "  });",
                  "  pm.collectionVariables.set('walkCursor', '');",
                  "  pm.collectionVariables.set('walkPages', 0);",
                  "  pm.collectionVariables.set('walkRecords', 0);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/mock-provider/invoices?duplicates=false&schemaDrift=false&nullFields=false&rateLimit=false&serverError=false&expiredToken=false&futureDates=false&cursor={{walkCursor}}"
          }
        },
        {
          "name": "Chaos: schemaDrift emits string amounts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "const strings = b.data.filter(r => typeof r.amount === 'string');",
                  "pm.test('part-way through the stream, amount arrives as a string', () => {",
                  "  pm.expect(strings.length, 'string-typed amounts on this page').to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/mock-provider/invoices?duplicates=false&nullFields=false&rateLimit=false&serverError=false&expiredToken=false&futureDates=false&schemaDrift=true&cursor=100",
            "description": "The upstream changes a field's type mid-stream. Downstream this must be accepted and coerced, not quarantined \u2014 see lib/ingestion/transform.ts."
          }
        },
        {
          "name": "Chaos: rateLimit returns 429",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fires on every 10th request, so ten attempts must produce one.",
                  "const n = Number(pm.collectionVariables.get('rlAttempts') || 0) + 1;",
                  "pm.collectionVariables.set('rlAttempts', n);",
                  "if (pm.response.code === 429) {",
                  "  pm.test('429 arrives within 10 requests', () => pm.expect(pm.response.code).to.eql(429));",
                  "  pm.test('429 carries Retry-After', () => {",
                  "    pm.expect(pm.response.headers.get('Retry-After'), 'Retry-After header').to.be.ok;",
                  "  });",
                  "  pm.collectionVariables.set('rlAttempts', 0);",
                  "} else if (n >= 10) {",
                  "  pm.test('429 arrives within 10 requests', () => pm.expect.fail('no 429 in ' + n + ' requests'));",
                  "  pm.collectionVariables.set('rlAttempts', 0);",
                  "} else {",
                  "  pm.execution.setNextRequest('Chaos: rateLimit returns 429');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/mock-provider/invoices?duplicates=false&schemaDrift=false&nullFields=false&serverError=false&expiredToken=false&futureDates=false&rateLimit=true",
            "description": "Retry-After is the point: a client that ignores it and hammers is the failure this flag exists to catch."
          }
        },
        {
          "name": "Chaos: serverError returns 500",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fires on every 25th request.",
                  "const n = Number(pm.collectionVariables.get('seAttempts') || 0) + 1;",
                  "pm.collectionVariables.set('seAttempts', n);",
                  "if (pm.response.code === 500) {",
                  "  pm.test('500 arrives within 25 requests', () => pm.expect(pm.response.code).to.eql(500));",
                  "  pm.collectionVariables.set('seAttempts', 0);",
                  "} else if (n >= 25) {",
                  "  pm.test('500 arrives within 25 requests', () => pm.expect.fail('no 500 in ' + n + ' requests'));",
                  "  pm.collectionVariables.set('seAttempts', 0);",
                  "} else {",
                  "  pm.execution.setNextRequest('Chaos: serverError returns 500');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/mock-provider/invoices?duplicates=false&schemaDrift=false&nullFields=false&rateLimit=false&expiredToken=false&futureDates=false&serverError=true"
          }
        },
        {
          "name": "Chaos: expiredToken returns 401",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// One token for the whole loop \u2014 a new one each iteration would reset the count.",
                  "if (!pm.collectionVariables.get('chaosToken')) {",
                  "  pm.collectionVariables.set('chaosToken', 'postman-' + Date.now());",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The provider counts requests per token string, so a fresh token survives",
                  "// exactly 15 and the 16th is rejected.",
                  "const n = Number(pm.collectionVariables.get('etAttempts') || 0) + 1;",
                  "pm.collectionVariables.set('etAttempts', n);",
                  "if (pm.response.code === 401) {",
                  "  pm.test('token expires after 15 requests', () => pm.expect(n).to.be.above(15));",
                  "  pm.collectionVariables.set('etAttempts', 0);",
                  "} else if (n >= 17) {",
                  "  pm.test('token expires after 15 requests', () => pm.expect.fail('no 401 in ' + n + ' requests'));",
                  "  pm.collectionVariables.set('etAttempts', 0);",
                  "} else {",
                  "  pm.execution.setNextRequest('Chaos: expiredToken returns 401');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{chaosToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/mock-provider/invoices?duplicates=false&schemaDrift=false&nullFields=false&rateLimit=false&serverError=false&futureDates=false&expiredToken=true"
          }
        }
      ],
      "description": "A deliberately adversarial upstream: duplicates, schema drift, null fields, 429s, 500s, expiring tokens, future dates."
    },
    {
      "name": "Stage 2 \u2014 Ingestion & Transform",
      "item": [
        {
          "name": "Trigger without the secret is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 without x-ingestion-secret', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/ingestion/run",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"org_id\": \"{{orgA}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "The route writes with the service-role client and takes org_id from its body, so this check is the only thing between a caller and any tenant. A filter the caller controls is not tenant isolation."
          }
        },
        {
          "name": "Trigger with a non-uuid org_id is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 for a malformed org_id', () => pm.response.to.have.status(400));",
                  "pm.test('error names the field', () => pm.expect(pm.response.json().error).to.include('org_id'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              },
              {
                "key": "x-ingestion-secret",
                "value": "{{ingestionSecret}}"
              }
            ],
            "url": "{{baseUrl}}/api/ingestion/run",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"org_id\": \"not-a-uuid\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Rewind Acme's cursor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('cursor rewound', () => pm.expect([204, 200]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "apikey",
                "value": "{{serviceRoleKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{serviceRoleKey}}"
              },
              {
                "key": "content-type",
                "value": "application/json"
              },
              {
                "key": "Prefer",
                "value": "return=minimal"
              }
            ],
            "url": "{{supabaseUrl}}/rest/v1/pipeline_runs?org_id=eq.{{orgA}}&kind=eq.incremental",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cursor_to\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Runs resume from the last succeeded run's cursor, so a second run against an already-drained dataset reads nothing. Rewinding makes the next request a full pass, which is what the idempotency test needs."
          }
        },
        {
          "name": "Run ingestion \u2014 Acme",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('run succeeded', () => pm.expect(b.status).to.eql('succeeded'));",
                  "pm.test('read something', () => pm.expect(b.rows_read).to.be.above(0));",
                  "// The PRD's \"zero silent drops\" counter-metric, made checkable: every record",
                  "// read landed in exactly one bucket.",
                  "pm.test('counters balance: read = written + quarantined + deduplicated', () => {",
                  "  pm.expect(b.counters_balanced, JSON.stringify(b)).to.be.true;",
                  "  pm.expect(b.rows_read).to.eql(b.rows_written + b.rows_quarantined + b.rows_deduplicated);",
                  "});",
                  "pm.test('a correlation_id came back', () => pm.expect(b.correlation_id).to.be.a('string'));",
                  "pm.collectionVariables.set('acmeRowsRead', b.rows_read);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              },
              {
                "key": "x-ingestion-secret",
                "value": "{{ingestionSecret}}"
              },
              {
                "key": "x-correlation-id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{baseUrl}}/api/ingestion/run",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"org_id\": \"{{orgA}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Rewind Acme's cursor again",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('cursor rewound', () => pm.expect([204, 200]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "apikey",
                "value": "{{serviceRoleKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{serviceRoleKey}}"
              },
              {
                "key": "content-type",
                "value": "application/json"
              },
              {
                "key": "Prefer",
                "value": "return=minimal"
              }
            ],
            "url": "{{supabaseUrl}}/rest/v1/pipeline_runs?org_id=eq.{{orgA}}&kind=eq.incremental",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cursor_to\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Re-run ingestion \u2014 Acme is idempotent",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('run succeeded', () => pm.expect(b.status).to.eql('succeeded'));",
                  "pm.test('re-read the same records', () => {",
                  "  pm.expect(b.rows_read).to.eql(Number(pm.collectionVariables.get('acmeRowsRead')));",
                  "});",
                  "// US-03. A second full pass over the same upstream data must write nothing",
                  "// new; every record is recognised as already ingested.",
                  "pm.test('nothing new written on the second pass', () => pm.expect(b.rows_written).to.eql(0));",
                  "pm.test('every record deduplicated', () => pm.expect(b.rows_deduplicated).to.eql(b.rows_read));",
                  "pm.test('counters still balance', () => pm.expect(b.counters_balanced).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              },
              {
                "key": "x-ingestion-secret",
                "value": "{{ingestionSecret}}"
              },
              {
                "key": "x-correlation-id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{baseUrl}}/api/ingestion/run",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"org_id\": \"{{orgA}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Rewind Globex's cursor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('cursor rewound', () => pm.expect([204, 200]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "apikey",
                "value": "{{serviceRoleKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{serviceRoleKey}}"
              },
              {
                "key": "content-type",
                "value": "application/json"
              },
              {
                "key": "Prefer",
                "value": "return=minimal"
              }
            ],
            "url": "{{supabaseUrl}}/rest/v1/pipeline_runs?org_id=eq.{{orgB}}&kind=eq.incremental",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cursor_to\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Run ingestion \u2014 Globex, same external_ids",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('run succeeded', () => pm.expect(b.status).to.eql('succeeded'));",
                  "// The Stage 2 review's CRITICAL finding: the idempotency key omitted org_id,",
                  "// so a second tenant ingesting the same external_ids was silently discarded \u2014",
                  "// no rows, no error, run reported as succeeded.",
                  "pm.test('a second tenant is not silently discarded', () => {",
                  "  pm.expect(b.rows_written + b.rows_deduplicated, JSON.stringify(b)).to.be.above(0);",
                  "});",
                  "pm.test('counters balance', () => pm.expect(b.counters_balanced).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              },
              {
                "key": "x-ingestion-secret",
                "value": "{{ingestionSecret}}"
              },
              {
                "key": "x-correlation-id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{baseUrl}}/api/ingestion/run",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"org_id\": \"{{orgB}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Quarantine is not empty",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A ranged request returns 206 Partial Content; the count lives in",
                  "// the Content-Range header either way.",
                  "pm.test('200 or 206', () => pm.expect([200, 206]).to.include(pm.response.code));",
                  "const range = pm.response.headers.get('Content-Range') || '';",
                  "const total = Number(range.split('/')[1]);",
                  "// The provider injects null customers. An empty quarantine would mean",
                  "// validation stopped rejecting them, not that the data got clean.",
                  "pm.test('invalid records were quarantined, not dropped', () => pm.expect(total).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{serviceRoleKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{serviceRoleKey}}"
              },
              {
                "key": "Prefer",
                "value": "count=exact"
              },
              {
                "key": "Range",
                "value": "0-0"
              }
            ],
            "url": "{{supabaseUrl}}/rest/v1/quarantine?select=id&org_id=eq.{{orgA}}"
          }
        }
      ],
      "description": "Auth on the trigger, counter balance, idempotency, and tenant-scoped idempotency across two orgs."
    },
    {
      "name": "Stage 3 \u2014 Data Quality & Reconciliation",
      "description": "Four checks per run: freshness, volume, uniqueness, reconciliation. The reconciliation assertion is the project's headline number.",
      "item": [
        {
          "name": "Checks without the secret are rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 without x-ingestion-secret', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/data-quality/run",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"org_id\": \"{{orgA}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
