    {
      "name": "Cross-cutting \u2014 RLS & tenant isolation",
      "item": [
        {
          "name": "anon cannot read invoices at all",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// After the least-privilege grants migration, anon holds no privileges on",
                  "// any public table \u2014 PostgREST refuses before RLS is even consulted.",
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('refused on privileges, not on rows', () => {",
                  "  pm.expect(pm.response.json().code).to.eql('42501');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anonKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{anonKey}}"
              }
            ],
            "url": "{{supabaseUrl}}/rest/v1/invoices?select=id&limit=1",
            "description": "Defence in depth: the grant is the outer door, RLS the inner one. This asserts the outer door, and the two requests after it assert the inner."
          }
        },
        {
          "name": "Sign in as Globex's user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('got an access token', () => pm.expect(b.access_token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('bobToken', b.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              },
              {
                "key": "apikey",
                "value": "{{anonKey}}"
              }
            ],
            "url": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{bobEmail}}\",\n  \"password\": \"{{bobPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "A real GoTrue sign-in, not an impersonated role. Every RLS policy keys off auth.uid(), which only exists inside a genuine JWT."
          }
        },
        {
          "name": "RLS: Globex's user sees zero Acme invoices",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 \u2014 empty, not an error', () => pm.response.to.have.status(200));",
                  "pm.test('zero rows of the other tenant', () => pm.expect(pm.response.json()).to.be.an('array').that.is.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anonKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bobToken}}"
              }
            ],
            "url": "{{supabaseUrl}}/rest/v1/invoices?select=id&org_id=eq.{{orgA}}",
            "description": "The pass condition is an empty 200. A 403 would also hide the data but would confirm the rows exist; RLS makes other tenants invisible."
          }
        },
        {
          "name": "RLS positive control: Globex sees its own",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "// Without this, the previous test proves nothing: a query returning zero",
                  "// because the token is wrong looks identical to one returning zero because",
                  "// RLS works.",
                  "pm.test('its own rows are visible', () => pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anonKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bobToken}}"
              }
            ],
            "url": "{{supabaseUrl}}/rest/v1/invoices?select=id&org_id=eq.{{orgB}}&limit=5"
          }
        }
      ],
      "description": "Privileges and RLS, checked through PostgREST as anon and as a real signed-in user."
    }
