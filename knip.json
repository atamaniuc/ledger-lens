{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The Playwright plugin tries to import playwright.config.ts, which throws
  // without .env.local (by design — the suite refuses to run against a machine
  // with no environment). The config and the specs are declared as entries
  // instead, so the e2e harness is never reported unused.
  "playwright": false,
  "entry": [
    "src/app/**/{page,layout,route,loading,error,not-found,proxy}.{ts,tsx}",

    "tests/**/*.ts",
    "playwright.config.ts",
    // Co-located unit, component and story files are consumers: without them
    // every constant a test asserts looks unused, which is how a dead-code
    // gate ends up reporting live code.
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.stories.tsx",
    "vitest.*.config.mts",
    ".storybook/**/*.{ts,tsx}",
    // Developer entrypoints: run by task targets, not imported by the app.
    "scripts/*.ts"
  ],
  "ignore": [
    // Deno Edge Functions: checked by `task deno-check`, invisible to the Node
    // module graph (npm: specifiers, .ts import extensions).
    "supabase/functions/**",
    // Supabase CLI scratch space, written by `supabase start`.
    "supabase/.temp/**",
    // Generated from the database schema by `task types`.
    "src/platform/supabase/database.types.ts",
    // Two self-contained projects with their own gates (`task check-py`,
    // `task check-infra`), excluded from the app's typecheck and lint for the
    // same reason. Their virtualenvs also carry vendored JavaScript.
    "py/**",
    "infra/**"
  ],
  // evals/run.ts shells out to the supabase CLI.
  "ignoreBinaries": ["supabase"]
}
