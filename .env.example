# Mock provider chaos flags — all default to true (see lib/mock-provider/chaos.ts).
# Set to "false" or "0" to disable a specific flag deploy-wide; per-request
# query param overrides (?duplicates=false) win over these.
# CHAOS_DUPLICATES=true
# CHAOS_SCHEMA_DRIFT=true
# CHAOS_NULL_FIELDS=true
# CHAOS_RATE_LIMIT=true
# CHAOS_SERVER_ERROR=true
# CHAOS_EXPIRED_TOKEN=true
# CHAOS_FUTURE_DATES=true

# Deterministic seed for the mock provider's dataset — same seed,
# same failure sequence.
# MOCK_PROVIDER_SEED=42
