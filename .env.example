# Template only — no real values. `task up` writes a working .env.local from the
# running local stack; this file documents every variable the app reads and is
# checked against the schema by a test (src/platform/config.test.ts), so a new
# key cannot be added to the schema and forgotten here.
#
# The schema itself is src/platform/config.ts: it parses once, fails at startup
# naming the variable that is wrong, and is the only place a default lives.
# Deploy-time values are set by the Pulumi program (infra/env.ts).

# ── Supabase, server side ────────────────────────────────────────────────────
# Server-only. The service-role key bypasses RLS, so it never reaches the
# browser (enforced by lint: src/platform/supabase/service-client.ts).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase, browser side ──────────────────────────────────────────────────
# Public by design: the anon key only ever reaches Postgres as the
# `authenticated` (or `anon`) role, and RLS is what protects the data.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Entry-point secrets ─────────────────────────────────────────────────────
# Each entry point refuses every request when its secret is unset. The two
# webhook secrets are HMAC keys: the signature covers
# `v1:<timestamp>:<nonce>:<rawBody>` and a nonce is single-use (D-19).
# INGESTION_TRIGGER_SECRET=
# WEBHOOK_SHARED_SECRET=
# EMBED_SHARED_SECRET=

# ── Which environment this is ───────────────────────────────────────────────
# dev | test | production. Chaos flags read this rather than guessing from
# NODE_ENV: unset means OFF everywhere except dev and test (D-16).
# APP_ENV=production

# ── Mock provider ───────────────────────────────────────────────────────────
# Deterministic seed: same seed, same failure sequence. The base URL defaults
# to the request's own origin (the mock provider is routes in this same app).
# MOCK_PROVIDER_SEED=42
# MOCK_PROVIDER_BASE_URL=

# Seven chaos flags. Unset means OFF unless APP_ENV is dev or test — a deployed
# instance must not rate-limit and 500 itself. Set "true"/"1" to force one on;
# a per-request query parameter (?duplicates=false) still wins for tests.
# CHAOS_DUPLICATES=true
# CHAOS_SCHEMA_DRIFT=true
# CHAOS_NULL_FIELDS=true
# CHAOS_RATE_LIMIT=true
# CHAOS_SERVER_ERROR=true
# CHAOS_EXPIRED_TOKEN=true
# CHAOS_FUTURE_DATES=true

# ── Ingestion ───────────────────────────────────────────────────────────────
# Wall-clock budget for one ingestion run, in milliseconds. The default (25s)
# fits inside a typical serverless request limit; the old 45s constant did not
# (D-17). Bounded 1s-300s by the schema.
# INGEST_BUDGET_MS=25000

# ── The copilot's model, and its failover chain ─────────────────────────────
# LLM_CHAIN is an ordered preference list tried in order on 429/5xx/timeout
# (decision 0010). It is not a load balancer: free models differ in quality, so
# the order is deterministic and the provider that answered is recorded on every
# llm_calls row. Rotating several keys of one provider to defeat its own
# free-tier limit is explicitly not done.
# LLM_CHAIN=groq,nvidia
# LLM_PROVIDER=groq
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# NVIDIA_API_KEY=
# NVIDIA_MODEL=
# Any other OpenAI-compatible endpoint. LLM_MODEL is required for it, because
# this provider deliberately has no default: the operator names the model, and
# an unpriced model costs a null in llm_calls.cost_cents rather than a
# fabricated zero.
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# ── Agent guardrails ────────────────────────────────────────────────────────
# Requests per window per user and per org, the window itself, and a daily
# spend ceiling in cents computed from llm_calls (0 disables the cap). Over the
# request limit is a 429; over the cap is a 402; both carry a reset time (D-18).
# AGENT_USER_RATE_LIMIT=60
# AGENT_ORG_RATE_LIMIT=300
# AGENT_RATE_LIMIT_WINDOW_SECONDS=3600
# AGENT_DAILY_COST_CAP_CENTS=1000
# Daily token budget per org, summed from llm_calls. Counts tokens, not cents,
# because a free-tier model records cost 0 while still burning the provider's
# quota. 0 disables it; the default is one free tier's daily allowance.
# AGENT_DAILY_TOKEN_CAP=200000

# ── The groundedness judge ──────────────────────────────────────────────────
# A separate provider on purpose: a model grading its own answer is not a
# second signal. py/ledgerlens_judge refuses to run when JUDGE_MODEL equals the
# answering model, and every provider it accepts has a free tier (spec 0008).
# JUDGE_PROVIDER=nvidia
# JUDGE_MODEL=
# JUDGE_API_KEY=
# JUDGE_BASE_URL=
