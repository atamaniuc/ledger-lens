# Template for supabase/.env (gitignored), which `supabase start` reads to
# fill the `env(...)` references in config.toml's [edge_runtime.secrets].
#
# Must match the value in the repo-root .env.local: the Playwright suite
# sends the secret from there, the Edge Function checks the one from here.

WEBHOOK_SHARED_SECRET=local-dev-webhook-secret

# Shared secret the `embed` Edge Function checks on inbound calls (ADR 0008 —
# it is the only path to a vector in this system, so it is not left open).
# Same two-copies rule as above: the app's copy lives in the repo-root
# .env.local, the function's copy here, and the two must match.
EMBED_SHARED_SECRET=local-dev-embed-secret
